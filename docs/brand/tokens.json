{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "ArmoSpectra Brand System v1.0 — dark-first design tokens. Source of truth: docs/brand/BRAND_SYSTEM.md",
  "color": {
    "$type": "color",
    "ink": {
      "900": { "$value": "#050507", "$description": "Page base, deepest corners" },
      "800": { "$value": "#0B0B0F", "$description": "Primary surface, cards" },
      "700": { "$value": "#131318", "$description": "Raised panel, inputs" },
      "600": { "$value": "#1C1C22", "$description": "Hairlines, borders" },
      "500": { "$value": "#26262E", "$description": "Disabled, inert states" }
    },
    "blue": {
      "300": { "$value": "#BFDBFF", "$description": "Chrome highlight stop, hover text. 13.8:1 on ink.800" },
      "400": { "$value": "#6BB4FF", "$description": "Inline emphasis, eyebrows, icon glow. 8.98:1 on ink.800" },
      "500": { "$value": "#3B8EF0", "$description": "Primary accent, CTA border, section rules. 5.91:1 on ink.800" },
      "600": { "$value": "#1F63C4", "$description": "Gradient mid, divider glow. 3.41:1 — not for body text" },
      "800": { "$value": "#0E2E5C", "$description": "Arc motif, ambient wash. 1.46:1 — ambient only" }
    },
    "neutral": {
      "white": { "$value": "#FFFFFF", "$description": "Headlines, logo, capability labels. 19.6:1 on ink.800" },
      "gray-200": { "$value": "#D8DADE", "$description": "Body copy. 14.0:1 on ink.800" },
      "gray-400": { "$value": "#9AA0A8", "$description": "Secondary, captions, metadata. 7.45:1 on ink.800" },
      "gray-600": { "$value": "#5A5F66", "$description": "Photo mid-tones, slide footers" }
    }
  },
  "coverageRatio": {
    "$description": "Target pixel coverage on any ArmoSpectra surface",
    "black": { "$value": "80%" },
    "white": { "$value": "15%" },
    "accent": { "$value": "5%" }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "display": { "$value": ["Montserrat", "Archivo", "Helvetica Neue", "system-ui", "sans-serif"], "$description": "Brand face. Carries everything." },
    "script": { "$value": ["Great Vibes", "Snell Roundhand", "cursive"], "$description": "Brand face. One use only: the principal's name." },
    "mono": { "$value": ["JetBrains Mono", "SFMono-Regular", "ui-monospace", "monospace"], "$description": "Documentation utility. NOT a brand face. Never in client-facing surfaces." }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "wordmark": { "$value": 200 },
    "lede": { "$value": 300 },
    "body": { "$value": 400 },
    "label": { "$value": 500 },
    "headline": { "$value": 800 },
    "display": { "$value": 900, "$description": "Spread numerals only" }
  },
  "letterSpacing": {
    "wordmark": { "$value": "0.32em" },
    "label": { "$value": "0.28em" },
    "eyebrow": { "$value": "0.22em" },
    "nav": { "$value": "0.18em" },
    "display": { "$value": "-0.005em" }
  },
  "fontSize": {
    "$type": "dimension",
    "$description": "px at a 1440pt viewport. Display tiers scale fluidly with clamp(); text tiers are fixed.",
    "display-xl": { "$value": "84px", "lineHeight": 0.94 },
    "display-l":  { "$value": "58px", "lineHeight": 0.96 },
    "display-m":  { "$value": "40px", "lineHeight": 1.00 },
    "heading":    { "$value": "21px", "lineHeight": 1.15 },
    "lede":       { "$value": "19px", "lineHeight": 1.55 },
    "body":       { "$value": "16px", "lineHeight": 1.50 },
    "label":      { "$value": "14px", "lineHeight": 1.00 },
    "caption":    { "$value": "13px", "lineHeight": 1.45 },
    "eyebrow":    { "$value": "12px", "lineHeight": 1.00 },
    "micro":      { "$value": "11px", "lineHeight": 1.40 }
  },
  "space": {
    "$type": "dimension",
    "$description": "Base unit 8px. Seven values only — a gap needing 30px means the composition is wrong.",
    "1":  { "$value": "8px",  "$description": "Inline gaps, icon padding" },
    "2":  { "$value": "16px", "$description": "Label to value" },
    "3":  { "$value": "24px", "$description": "Card padding, grid gap" },
    "5":  { "$value": "40px", "$description": "Block separation" },
    "7":  { "$value": "56px", "$description": "Section opener" },
    "9":  { "$value": "72px", "$description": "Major section break" },
    "12": { "$value": "96px", "$description": "Page / spread padding" }
  },
  "layout": {
    "pageMargin": { "$value": "10.4%", "$description": "From the source poster: 98px text inset on a 940px canvas" },
    "gridColumns": { "$value": 12 },
    "gridGutter": { "$value": "16px" },
    "measure": { "$value": "66ch", "$description": "Maximum running-text width" },
    "textColumnMax": { "$value": "7 of 12", "$description": "When paired with an image" },
    "slideMargin": { "$value": "7.5%", "$description": "On a 1920x1080 canvas" }
  },
  "component": {
    "capabilityRowHeight": { "$value": "74px" },
    "iconBox": { "$value": "44px" },
    "iconCanvas": { "$value": "24px" },
    "iconStroke": { "$value": 1.5 },
    "ctaHeight": { "$value": "56px" },
    "sectionRule": { "$value": "70px x 2px" },
    "radiusCard": { "$value": "12px" },
    "radiusPill": { "$value": "9999px" },
    "hairline": { "$value": "1px", "$description": "Gradient, never a flat stroke" }
  },
  "gradient": {
    "chrome": {
      "$value": "linear-gradient(180deg,#FFFFFF 0%,#DCE9FF 30%,#7FB6F5 62%,#2E6FD0 100%)",
      "$description": "Display type only. Max two words per headline. Never below 48px. Not reproducible in print."
    },
    "ambient": {
      "$value": "radial-gradient(120% 120% at 75% 0%,#1A1B20 0%,#050507 70%)",
      "$description": "Page ground. Single light source, upper right."
    },
    "divider": {
      "$value": "linear-gradient(90deg,#1C1C22 0%,#3B8EF0 85%,transparent 100%)",
      "$description": "Glowing hairline. Always left-dark to right-bright."
    },
    "bloom": {
      "$value": "radial-gradient(60% 100% at 50% 100%,rgba(59,142,240,.45) 0%,rgba(5,5,7,0) 70%)",
      "$description": "Ambient accent wash"
    }
  },
  "shadow": {
    "glow": { "$value": "0 0 40px rgba(59,142,240,.35)" },
    "glowSoft": { "$value": "0 0 24px rgba(59,142,240,.30)" },
    "focusRing": { "$value": "0 0 0 3px rgba(59,142,240,.16)" },
    "$description": "No drop shadows on UI elements. Depth comes from the ground gradient and hairlines."
  },
  "texture": {
    "grainOpacity": { "$value": 0.035, "$description": "feTurbulence fractalNoise over any gradient field larger than ~400px" }
  },
  "motion": {
    "duration": { "$value": "400ms" },
    "travel": { "$value": "12px", "$description": "Fade-and-rise on scroll, once per element" },
    "easing": { "$value": "cubic-bezier(.22,.61,.36,1)" },
    "$description": "No parallax, no counters, no autoplay video. Respect prefers-reduced-motion."
  },
  "contrast": {
    "$description": "WCAG 2.1 ratios computed against surface #0B0B0F",
    "white": { "$value": 19.65 },
    "gray-200": { "$value": 14.04 },
    "blue-300": { "$value": 13.84 },
    "blue-400": { "$value": 8.98 },
    "gray-400": { "$value": 7.45 },
    "blue-500": { "$value": 5.91 },
    "blue-600": { "$value": 3.41 },
    "blue-800": { "$value": 1.46 },
    "white-on-blue-500": { "$value": 3.33, "$description": "FAILS AA. The technical reason filled blue buttons are off-brand." },
    "ink-900-on-blue-500": { "$value": 6.12, "$description": "Correct pairing if a filled blue chip is unavoidable." }
  },
  "capabilities": {
    "$description": "Fixed vocabulary. Fixed order. Never substitute synonyms.",
    "$value": ["Visibility", "Capture", "Follow-up", "Portals", "Automation", "AI Readiness"],
    "stages": ["Visibility", "Capture", "Follow-up", "Portals"],
    "substrate": ["Automation", "AI Readiness"]
  },
  "copy": {
    "$description": "Fixed strings. Do not paraphrase for a channel.",
    "tagline": { "$value": "Build the system behind your growth." },
    "descriptor": { "$value": "Growth Operating Systems for Modern Businesses." },
    "oneLiner": { "$value": "Websites, visibility, portals, dashboards, and workflows, connected into one system." }
  }
}
